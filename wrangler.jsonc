{
  "name": "taksonomi",
  "main": "server/worker.ts",
  "compatibility_date": "2026-07-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Holds the decided daily boards, so a deploy of categories-data.ts partway
  // through a day cannot hand later players a different board from earlier
  // ones. See "Daglig utfordring" in README.md.
  //
  // The id is account-specific. On a fresh account, make one and swap it in:
  //   npx wrangler kv namespace create BOARDS
  // `wrangler dev` simulates KV locally and ignores the id; `wrangler deploy`
  // refuses an id it cannot find, which is the loud failure we want.
  "kv_namespaces": [{ "binding": "BOARDS", "id": "3762248672f14250aed75439b1fe8859" }]
}
